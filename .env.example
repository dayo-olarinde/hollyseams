# ============================================================
# Environment variables — copy to .env and fill in real values.
# Secrets are generated for you in .env by the scaffolder.
# ============================================================

NODE_ENV=development
PORT=7000
BASE_URL=http://localhost:7000
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:change-me@localhost:5432/hollyseams
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hollyseams
POSTGRES_PORT=5432
# Size of the postgres-js connection pool.
DATABASE_MAX_CONNECTIONS=5

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
