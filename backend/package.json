{
  "name": "hollyseams-nest",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "bun dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "bun src/database/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^6.3.6",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.1",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.5.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.0.0"
  }
}
